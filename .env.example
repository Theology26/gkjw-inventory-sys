# ==============================================================================
# GKJW SUKUN INVENTORY & ARCHIVE SYSTEM v2.0 - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and adjust values for your local environment.
# NEVER commit the actual .env file with production credentials to Git!
# ==============================================================================

# Application Meta
APP_NAME="GKJW Sukun Inventory & Archive System"
APP_ENV=development
APP_PORT=8000

# Security (Replace with a strong random 32+ character key in production)
JWT_SECRET_KEY=change_this_to_a_long_random_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (PostgreSQL 16+ or 18)
# Format: postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
DATABASE_URL=postgresql://postgres:your_local_db_password@127.0.0.1:5432/gkjw_sukun_inventory

# File Storage & Uploads
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE_MB=10

# Official System Contact
CONTACT_EMAIL=multimedia.gkjwsukun@gmail.com

